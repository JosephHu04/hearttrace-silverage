# Use placeholders only. Never commit real credentials.
DATABASE_URL=postgresql://hearttrace:change-me@localhost:5432/hearttrace
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXP_MINUTES=60
SEED_DEMO_DATA=false
ENABLE_DEMO_LOGIN=false
CORS_ORIGINS=["https://admin.example.com","https://family.example.com","https://elder.example.com"]
REDIS_URL=redis://localhost:6379/0
MODEL_BASE_URL=https://your-model-gateway.example/v1
MODEL_API_KEY=replace-me
# Alibaba Cloud Model Studio / DashScope. Keep real values only in local environment or a secret manager.
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TIMEOUT_SECONDS=30
# The realtime companion uses the cheaper Flash model independently from analysis.
DASHSCOPE_COMPANION_MODEL=qwen3.8-flash
DASHSCOPE_COMPANION_TIMEOUT_SECONDS=30
COMPANION_HISTORY_LIMIT=16
COMPANION_HISTORY_CHARACTER_BUDGET=3200
COMPANION_MAX_TOKENS=160
ELDER_DEFAULT_LOCATION=澳门
ELDER_DEFAULT_LATITUDE=22.1987
ELDER_DEFAULT_LONGITUDE=113.5439
# Local speech services reused from the teammate's Companion CN project.
FUNASR_URL=http://127.0.0.1:10095
FISH_SPEECH_URL=http://127.0.0.1:50000
FISH_SPEECH_REFERENCE_ID=song_yusheng_square_4_denoised
FISH_SPEECH_SAMPLE_RATE=44100
SPEECH_SERVICE_API_KEY=
# Cloud speech is the default. Use a separate key in services/api/.env.speech or a secret manager.
SPEECH_PROVIDER=dashscope
SPEECH_DASHSCOPE_API_KEY=replace-me
SPEECH_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
SPEECH_ASR_MODEL=qwen3-asr-flash
SPEECH_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
SPEECH_TTS_MODEL=qwen-audio-3.0-tts-flash
SPEECH_TTS_VOICE=longanfengyue
SPEECH_REQUEST_TIMEOUT_SECONDS=180
SPEECH_MAX_AUDIO_BYTES=8000000
SPEECH_MAX_TTS_CHARACTERS=800
OBJECT_STORAGE_ENDPOINT=https://storage.example
OBJECT_STORAGE_BUCKET=hearttrace-dev
DEVICE_EVENT_SIGNING_KEY=replace-me
